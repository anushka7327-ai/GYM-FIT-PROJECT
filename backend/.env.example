# ========================================================
# GymFit Backend Environment Variables (Production & Render)
# ========================================================

# Server Port (Render automatically injects PORT)
PORT=5000

# Environment Mode (production / development)
NODE_ENV=production

# MongoDB Atlas Connection URI
# Obtain from MongoDB Atlas -> Connect -> Drivers (Node.js)
# Example: mongodb+srv://gymfit_user:StrongPassword123@cluster0.abcde.mongodb.net/gymfit?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-name>.xxxxx.mongodb.net/gymfit?retryWrites=true&w=majority

# JWT Signing Secret (Generate a strong random string: e.g. openssl rand -base64 32)
JWT_SECRET=your_jwt_production_secret_key_minimum_32_chars

# JWT Token Expiry (e.g., 30d, 7d, 24h)
JWT_EXPIRE=30d

# Optional Admin Secret Key (used only if registering an admin account through public API)
ADMIN_SECRET=your_admin_registration_secret_passphrase

# Frontend Client URL for CORS Whitelist (Your deployed Vercel frontend)
# Supports comma-separated origins if you have custom domains or preview URLs
CLIENT_URL=https://your-app-name.vercel.app
